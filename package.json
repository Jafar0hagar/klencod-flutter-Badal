{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "prebuild": "python3 -c \"import os, zipfile; os.makedirs('public', exist_ok=True); zipf = zipfile.ZipFile('public/badal_mobile_app.zip', 'w', zipfile.ZIP_DEFLATED); [zipf.write(os.path.join(r, f), os.path.relpath(os.path.join(r, f), 'badal_mobile_app')) for r, d, fs in os.walk('badal_mobile_app') for f in fs]; zipf.close()\"",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist .next out",
    "lint": "tsc --noEmit",
    "cap:sync": "cap sync",
    "cap:add": "cap add android",
    "cap:open": "cap open android",
    "build:android": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.17",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
